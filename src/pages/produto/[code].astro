---
export const prerender = false;

import { supabase } from '../../lib/supabase';

const { code: routeCode } = Astro.params;

// Determina variante e extrai o num do código (VZB0123 ou VZF0123)
const variant = routeCode?.startsWith('VZB') ? 'brilho' : routeCode?.startsWith('VZF') ? 'fosco' : null;
const num = routeCode ? parseInt(routeCode.replace(/^VZ[BF]0/, ''), 10) : null;

if (!variant || !num || isNaN(num)) {
  return Astro.redirect('/');
}

const { data: p } = await supabase.from('products').select('*').eq('num', num).single();

if (!p) {
  return Astro.redirect('/');
}

const codeB = `VZB0${p.num}`;
const codeF = `VZF0${p.num}`;

const SITE_URL = 'https://vizorpeliculas.com.br';
const BUCKET_URL = 'https://bbrxcoxuzulieywudotl.supabase.co/storage/v1/object/public/products-images';
const imgPath = p.image_url ?? `${BUCKET_URL}/${p.folder}/${p.file}`;
const ogImage = p.image_url ?? `${BUCKET_URL}/${p.folder}/${p.file}`;
const productName = `${p.brand} ${p.model}${p.year ? ` (${p.year})` : ''}`;
const variantLabel = variant === 'brilho' ? 'Brilho' : 'Fosco';
const code = variant === 'brilho' ? codeB : codeF;
const title = `${productName} — Película ${variantLabel} | Vizor Películas`;
const description = `Película protetora para painel do ${productName}. Código ${code}. Fabricação nacional, acabamento ${variantLabel}.`;
const canonicalUrl = `${SITE_URL}/produto/${code}`;
const wppMsg = `Olá! Vi esse produto no site da Vizor Películas e tenho interesse:\n\n*${p.model}* (${p.year})\nCódigo: ${code}\n\n🔗 ${canonicalUrl}`;
const wppUrl = `https://wa.me/5551980230392?text=${encodeURIComponent(wppMsg)}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph — WhatsApp usa og:image como thumbnail -->
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="Vizor Películas Protetoras" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content={`Película protetora ${productName}`} />
    <meta property="og:locale" content="pt_BR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Barlow', system-ui, sans-serif;
        background: #f5f7fa;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.10);
        max-width: 480px;
        width: 100%;
        overflow: hidden;
      }
      .card__img-wrap {
        background: #f0f4f8;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        border-bottom: 1px solid #e8edf2;
      }
      .card__img {
        width: 200px;
        height: 200px;
        object-fit: contain;
      }
      .card__body {
        padding: 28px 32px 32px;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .card__brand {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #2a7cc7;
      }
      .card__model {
        font-size: 22px;
        font-weight: 700;
        color: #0d1f2d;
        line-height: 1.2;
      }
      .card__year {
        font-size: 14px;
        color: #9aa5b0;
        margin-top: -10px;
      }
      .card__codes {
        display: flex;
        gap: 24px;
        padding: 14px 16px;
        background: #f5f7fa;
        border-radius: 8px;
      }
      .card__code-label {
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #9aa5b0;
        margin-bottom: 4px;
      }
      .card__code-value {
        font-family: monospace;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.03em;
      }
      .card__code-value--brilho { color: #2a7cc7; }
      .card__code-value--fosco  { color: #0d1f2d; }
      .card__badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        width: fit-content;
      }
      .card__badge--brilho { background: #e8f1fb; color: #2a7cc7; }
      .card__badge--fosco  { background: #f0f0f0; color: #555; }
      .btn-wpp {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 20px;
        background: #128C4A;
        color: #fff;
        font-family: inherit;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 6px;
        text-decoration: none;
        border-left: 4px solid #25D366;
        transition: background 0.15s;
        width: 100%;
        justify-content: center;
      }
      .btn-wpp:hover { background: #0f7a3f; }
      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #2a7cc7;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        justify-content: center;
      }
      .btn-back:hover { text-decoration: underline; }
      .logo-wrap {
        text-align: center;
        margin-bottom: 20px;
      }
      .logo-wrap img { height: 36px; }
    </style>
  </head>
  <body>
    <div class="logo-wrap">
      <a href="/">
        <img src="/logo.svg" alt="Vizor Películas" />
      </a>
    </div>

    <div class="card">
      <div class="card__img-wrap">
        <img src={imgPath} alt={productName} class="card__img" />
      </div>
      <div class="card__body">
        <div>
          <div class="card__brand">{p.brand}</div>
          <div class="card__model">{p.model}</div>
          {p.year && <div class="card__year">{p.year}</div>}
        </div>

        <span class={`card__badge card__badge--${variant}`}>Acabamento {variantLabel}</span>

        <div class="card__codes">
          <div>
            <div class="card__code-label">Brilho</div>
            <div class="card__code-value card__code-value--brilho">{codeB}</div>
          </div>
          <div>
            <div class="card__code-label">Fosco</div>
            <div class="card__code-value card__code-value--fosco">{codeF}</div>
          </div>
        </div>

        <a href={wppUrl} target="_blank" rel="noopener noreferrer" class="btn-wpp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Tenho interesse
        </a>

        <a href="/#buscador" class="btn-back">
          ← Buscar outro modelo
        </a>
      </div>
    </div>
  </body>
</html>
