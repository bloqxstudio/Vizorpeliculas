---
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const SITE_URL = 'https://vizorpeliculas.com.br';

const {
  title,
  description = 'Fabricante nacional de películas protetoras para painéis de instrumentos de motocicletas. Mais de 200 modelos em acabamento Brilho e Fosco. Honda, Yamaha, Kawasaki, BMW e muito mais. São Leopoldo, RS.',
  ogImage = `${SITE_URL}/og-image.png`,
  canonicalUrl = SITE_URL,
} = Astro.props;

const fullTitle = title === 'Vizor Películas Protetoras'
  ? title
  : `${title} | Vizor Películas Protetoras`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="película protetora moto, película painel moto, proteção painel motocicleta, película honda, película yamaha, película kawasaki, película BMW moto, vizor películas, São Leopoldo RS" />
    <meta name="author" content="Vizor Películas Protetoras" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vizor Películas Protetoras" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vizor Películas Protetoras — Fabricante nacional de películas para motos" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card (também usado pelo X/Twitter) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Vizor Películas Protetoras — Fabricante nacional de películas para motos" />

    <!-- CSS crítico inline: renderiza fundo, cores e layout base antes de qualquer arquivo externo -->
    <style is:inline>
      :root {
        --vz-900: #021A2D;
        --vz-800: #0A2E4A;
        --vz-700: #0D3E63;
        --vz-600: #1A5C8A;
        --vz-500: #2172A8;
        --vz-400: #2E8BC7;
        --vz-300: #5BAEE0;
        --vz-200: #93CDF0;
        --vz-100: #C6E6F8;
        --vz-50:  #EAF5FC;
        --vz-gray-900: #1C2730;
        --vz-gray-700: #3A4B57;
        --vz-gray-500: #6B7E8C;
        --vz-gray-300: #B8C4CC;
        --vz-gray-100: #EDF0F2;
        --vz-off-white: #F5F7F9;
        --font-display: 'Barlow Condensed', sans-serif;
        --font-body: 'Barlow', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --section-py: 100px;
        --container-px: 32px;
        --container-max: 1280px;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background-color: #F5F7F9;
        color: #1C2730;
        font-family: 'Barlow', sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      img { max-width: 100%; height: auto; }

      /* Navbar acima de tudo imediatamente */
      .navbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 100;
        background-color: rgba(10, 46, 74, 0.95);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(46, 139, 199, 0.15);
      }

      /* Hero ocupa viewport imediatamente — sem relayout */
      .hero {
        position: relative;
        width: 100%;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background-color: #0A2E4A;
        background-image:
          linear-gradient(105deg,
            rgba(2,26,45,0.95) 0%,
            rgba(10,46,74,0.90) 40%,
            rgba(10,46,74,0.70) 70%,
            rgba(10,46,74,0.50) 100%),
          url('/bg.png');
        background-size: cover;
        background-position: center 35%;
      }

      /* Oculta elementos animados pelo GSAP até ele rodar */
      .gsap-init { visibility: hidden; }

      /* Navbar oculta via CSS — GSAP sobrescreve no momento certo */
      #navbar { opacity: 0; }

      @media (max-width: 768px) {
        :root {
          --section-py: 64px;
          --container-px: 20px;
        }
      }
    </style>

    <!-- Preconnect para fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts: não-bloqueante com font-display=swap -->
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <Preloader />
    <slot />

    <!-- Botão flutuante WhatsApp -->
    <a
      href="https://wa.me/5551980230392"
      target="_blank"
      rel="noopener noreferrer"
      class="wpp-float"
      aria-label="Fale conosco pelo WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </a>

    <style is:inline>
      .wpp-float {
        position: fixed;
        bottom: 28px;
        right: 28px;
        z-index: 9998;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background-color: #25D366;
        color: #fff;
        border-radius: 50%;
        box-shadow: 0 4px 16px rgba(37, 211, 102, 0.45);
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .wpp-float:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 24px rgba(37, 211, 102, 0.6);
      }
      @media (max-width: 768px) {
        .wpp-float {
          bottom: 20px;
          right: 20px;
          width: 50px;
          height: 50px;
        }
        .wpp-float svg { width: 24px; height: 24px; }
      }
    </style>

    <!-- GSAP no final do body: não bloqueia parsing nem renderização -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
  </body>
</html>
