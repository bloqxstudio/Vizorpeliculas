---
// Footer — Vizor Películas Protetoras
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <!-- Top border -->
  <div class="footer__border" aria-hidden="true"></div>

  <div class="vz-container footer__inner">

    <!-- Brand column -->
    <div class="footer__brand">
      <!-- Logo -->
      <a href="/" class="footer__logo" aria-label="Vizor Películas Protetoras — Ir para o início">
        <img src="/logo.svg" alt="Vizor Películas Protetoras" class="footer__logo-img" />
      </a>

      <p class="footer__tagline">
        Proteção e estilo para o painel da sua moto.
        Fabricação nacional, qualidade técnica, propósito em cada detalhe.
      </p>

      <!-- Social links -->
      <div class="footer__social" aria-label="Redes sociais">
        <a href="#" class="footer__social-link" aria-label="Instagram da Vizor" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="YouTube da Vizor" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
          </svg>
        </a>
        <a href="https://wa.me/5551980230392" class="footer__social-link footer__social-link--whatsapp" aria-label="WhatsApp da Vizor" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Nav column -->
    <nav class="footer__nav" aria-label="Links rápidos">
      <h3 class="footer__nav-title">Links rápidos</h3>
      <ul class="footer__nav-list">
        <li><a href="#produtos" class="footer__nav-link">Produtos</a></li>
        <li><a href="#buscador" class="footer__nav-link">Buscar compatibilidade</a></li>
        <li><a href="#marcas" class="footer__nav-link">Marcas atendidas</a></li>
        <li><a href="#sobre" class="footer__nav-link">Sobre a Vizor</a></li>
        <li><a href="#revendedor" class="footer__nav-link">Seja revendedor</a></li>
      </ul>
    </nav>

    <!-- Products column -->
    <nav class="footer__nav" aria-label="Marcas em destaque">
      <h3 class="footer__nav-title">Marcas em destaque</h3>
      <ul class="footer__nav-list">
        <li><a href="#marcas" class="footer__nav-link">Honda</a></li>
        <li><a href="#marcas" class="footer__nav-link">Yamaha</a></li>
        <li><a href="#marcas" class="footer__nav-link">Kawasaki</a></li>
        <li><a href="#marcas" class="footer__nav-link">BMW</a></li>
        <li><a href="#marcas" class="footer__nav-link">Ducati</a></li>
        <li><a href="#marcas" class="footer__nav-link">Royal Enfield</a></li>
      </ul>
    </nav>

    <!-- Contact column -->
    <div class="footer__contact">
      <h3 class="footer__nav-title">Contato</h3>
      <address class="footer__address">
        <div class="footer__contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Av. Arnaldo Pereira da Silva, 299<br />São Leopoldo, RS — CEP 93115000</span>
        </div>
        <div class="footer__contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.98-.98a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <a href="tel:+5551980230393" class="footer__contact-link">(51) 98023-0393</a>
        </div>
        <div class="footer__contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <a href="https://www.vizor.com.br" class="footer__contact-link" target="_blank" rel="noopener">www.vizor.com.br</a>
        </div>
      </address>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="vz-container footer__bottom-inner">
      <p class="footer__copy">
        © {year} Vizor Películas Protetoras. Todos os direitos reservados.
        Produtos de reposição, não originais, compatíveis com os modelos descritos.
      </p>
      <p class="footer__made">
        <span class="footer__made-dot" aria-hidden="true"></span>
        Fabricação 100% Brasileira · São Leopoldo, RS
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--vz-900);
    color: rgba(255,255,255,0.5);
  }

  .footer__border {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(46,139,199,0.3), rgba(46,139,199,0.3), transparent);
  }

  /* Inner layout */
  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 56px;
  }

  /* Brand */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .footer__logo-img {
    height: 28px;
    width: auto;
    display: block;
  }

  .footer__logo-sub {
    display: none;
    line-height: 1;
  }

  .footer__tagline {
    font-size: 13.5px;
    line-height: 1.65;
    color: rgba(255,255,255,0.35);
    margin: 0;
    max-width: 260px;
  }

  .footer__social {
    display: flex;
    gap: 8px;
  }

  .footer__social-link {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .footer__social-link:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
    border-color: rgba(255,255,255,0.15);
  }

  .footer__social-link--whatsapp:hover {
    color: #25D366;
    background: rgba(37,211,102,0.1);
    border-color: rgba(37,211,102,0.2);
  }

  /* Nav columns */
  .footer__nav {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__nav-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin: 0;
  }

  .footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__nav-link {
    font-size: 14px;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__nav-link:hover {
    color: rgba(255,255,255,0.85);
  }

  /* Contact */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.5;
    color: rgba(255,255,255,0.45);
  }

  .footer__contact-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--vz-400);
  }

  .footer__contact-link {
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer__contact-link:hover {
    color: var(--vz-300);
  }

  /* Bottom bar */
  .footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 24px;
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: 12px;
    color: rgba(255,255,255,0.25);
    margin: 0;
    line-height: 1.5;
    max-width: 540px;
  }

  .footer__made {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: rgba(255,255,255,0.3);
    margin: 0;
    white-space: nowrap;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .footer__made-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--vz-400);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .footer__brand { grid-column: span 2; }
  }

  @media (max-width: 600px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
    .footer__brand { grid-column: span 1; }
    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
