---
// Revendedor — Formulário B2B
---

<section id="revendedor" class="revend" aria-labelledby="revend-title">
  <div class="vz-container revend__inner">

    <!-- Left: pitch -->
    <div class="revend__pitch">
      <p class="vz-overline">Seja revendedor</p>
      <h2 id="revend-title" class="vz-display-l revend__title">
        TRABALHE COM<br />
        <span class="revend__title-accent">A VIZOR</span>
      </h2>

      <div class="vz-divider" style="margin: 4px 0;"></div>

      <p class="revend__text">
        Somos um fabricante nacional em expansão. Traga a Vizor para sua loja e
        ofereça aos seus clientes películas protetoras de qualidade técnica comprovada.
      </p>

      <!-- Benefits -->
      <ul class="revend__benefits">
        <li class="revend__benefit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Margem competitiva para revendedores
        </li>
        <li class="revend__benefit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Suporte comercial e material de vendas
        </li>
        <li class="revend__benefit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Catálogo com mais de 200 modelos
        </li>
        <li class="revend__benefit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          Atualização contínua de lançamentos
        </li>
      </ul>

      <!-- Contact direct -->
      <div class="revend__direct">
        <p class="revend__direct-label">Contato direto:</p>
        <a href="https://wa.me/5551980230392" class="revend__whatsapp" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Vizor">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          (51) 98023-0392
        </a>
      </div>
    </div>

    <!-- Right: form -->
    <div class="revend__form-wrap">
      <form class="revend__form" id="revend-form" novalidate>
        <div class="revend__form-header">
          <h3 class="revend__form-title">Quero ser revendedor</h3>
          <p class="revend__form-sub">Preencha e entraremos em contato em até 48h.</p>
        </div>

        <!-- Nome -->
        <div class="revend__field">
          <label class="revend__label" for="r-nome">Nome completo *</label>
          <input
            type="text"
            id="r-nome"
            name="nome"
            class="revend__input"
            placeholder="Seu nome"
            required
            autocomplete="name"
          />
        </div>

        <!-- Empresa -->
        <div class="revend__field">
          <label class="revend__label" for="r-empresa">Empresa / Loja *</label>
          <input
            type="text"
            id="r-empresa"
            name="empresa"
            class="revend__input"
            placeholder="Nome da sua empresa"
            required
          />
        </div>

        <!-- Cidade -->
        <div class="revend__field">
          <label class="revend__label" for="r-cidade">Cidade / Estado *</label>
          <input
            type="text"
            id="r-cidade"
            name="cidade"
            class="revend__input"
            placeholder="Ex: Porto Alegre, RS"
            required
          />
        </div>

        <!-- WhatsApp -->
        <div class="revend__field">
          <label class="revend__label" for="r-whatsapp">WhatsApp *</label>
          <div class="revend__input-wrap">
            <span class="revend__input-prefix" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </span>
            <input
              type="tel"
              id="r-whatsapp"
              name="whatsapp"
              class="revend__input revend__input--with-prefix"
              placeholder="(51) 99999-9999"
              required
              autocomplete="tel"
            />
          </div>
        </div>

        <!-- Honeypot (anti-bot, invisível para humanos) -->
        <div style="position:absolute;left:-9999px;opacity:0;pointer-events:none;" aria-hidden="true">
          <label for="r-website">Website</label>
          <input type="text" id="r-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Submit -->
        <button type="submit" class="revend__submit" id="revend-submit">
          <span class="revend__submit-text">Quero ser revendedor</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </button>

        <!-- Success message (hidden) -->
        <div class="revend__success" id="revend-success" role="alert" aria-live="polite">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          Mensagem enviada! Entraremos em contato em breve.
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .revend {
    background-color: var(--vz-off-white);
    padding: var(--section-py) 0;
    position: relative;
  }

  .revend::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--vz-600), var(--vz-400), var(--vz-600));
  }

  .revend__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Pitch */
  .revend__pitch {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .revend__title {
    color: var(--vz-700);
    margin: 0;
  }

  .revend__title-accent { color: var(--vz-600); }

  .revend__text {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--vz-gray-500);
    margin: 0;
  }

  .revend__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .revend__benefit {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--vz-gray-700);
  }

  .revend__benefit svg {
    color: var(--vz-600);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .revend__direct {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--vz-gray-100);
  }

  .revend__direct-label {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vz-gray-500);
    margin: 0;
  }

  .revend__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 18px;
    color: #25D366;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .revend__whatsapp:hover { opacity: 0.8; }

  /* Form */
  .revend__form-wrap {
    background: #fff;
    border: 1px solid var(--vz-gray-100);
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 4px 32px rgba(10,46,74,0.06);
  }

  .revend__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .revend__form-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 4px;
  }

  .revend__form-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 20px;
    color: var(--vz-gray-900);
    margin: 0;
  }

  .revend__form-sub {
    font-size: 14px;
    color: var(--vz-gray-500);
    margin: 0;
  }

  .revend__field {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .revend__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--vz-gray-700);
  }

  .revend__input {
    appearance: none;
    background: var(--vz-off-white);
    border: 1.5px solid var(--vz-gray-300);
    color: var(--vz-gray-900);
    font-family: var(--font-body);
    font-size: 15px;
    padding: 13px 16px;
    border-radius: 6px;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
  }

  .revend__input:focus {
    outline: none;
    border-color: var(--vz-600);
    box-shadow: 0 0 0 3px rgba(26,92,138,0.12);
    background: #fff;
  }

  .revend__input::placeholder {
    color: var(--vz-gray-500);
    opacity: 0.7;
  }

  .revend__input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .revend__input-prefix {
    position: absolute;
    left: 14px;
    color: #25D366;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .revend__input--with-prefix {
    padding-left: 40px;
  }

  /* Submit */
  .revend__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--vz-600);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 16px;
    padding: 16px 28px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.15s;
    width: 100%;
    margin-top: 4px;
  }

  .revend__submit:hover {
    background-color: var(--vz-500);
    transform: translateY(-1px);
  }

  .revend__submit:active {
    transform: translateY(0);
  }

  /* Success */
  .revend__success {
    display: none;
    align-items: center;
    gap: 10px;
    background: var(--vz-success-bg);
    color: var(--vz-success-text);
    border-radius: 6px;
    padding: 14px 18px;
    font-size: 14.5px;
    font-weight: 600;
  }

  .revend__success.visible {
    display: flex;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .revend__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .revend__form-wrap { padding: 28px 24px; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('revend-form') as HTMLFormElement;
  const successEl = document.getElementById('revend-success') as HTMLDivElement;
  const submitBtn = document.getElementById('revend-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span>Enviando...</span>';

    const data = new FormData(form);

    // Honeypot: bots preenchem esse campo, humanos não
    if (data.get('website')) return;

    const nome     = (data.get('nome')     as string).trim().slice(0, 120);
    const empresa  = (data.get('empresa')  as string).trim().slice(0, 120);
    const cidade   = (data.get('cidade')   as string).trim().slice(0, 120);
    const whatsapp = (data.get('whatsapp') as string).trim().slice(0, 30);

    const { error } = await supabase.from('distributor_leads').insert({
      nome, empresa, cidade, whatsapp,
    });

    if (error) {
      console.error('Erro ao salvar lead:', error.message);
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Quero ser revendedor</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>';
      return;
    }

    form.reset();
    submitBtn.style.display = 'none';
    successEl?.classList.add('visible');
  });
</script>
