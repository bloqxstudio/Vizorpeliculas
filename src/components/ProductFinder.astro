---
import { supabase } from '../lib/supabase';

const { data: products } = await supabase
  .from('products')
  .select('num, brand, model, year, code_b, code_f, image_url')
  .order('num');

// Normaliza brand name para chave do select
function brandKey(brand: string): string {
  return brand.toLowerCase().replace(/[\s\-\/]+/g, '_');
}

// Monta catalog agrupado por marca
const catalogMap: Record<string, { num: number; model: string; year: string; codeB: string; codeF: string }[]> = {};
const imgMap: Record<string, string> = {};
const brandLabels: Record<string, string> = {};

for (const p of products ?? []) {
  const key = brandKey(p.brand);
  const codeB = p.code_b;
  const codeF = p.code_f;

  if (!catalogMap[key]) {
    catalogMap[key] = [];
    brandLabels[key] = p.brand;
  }
  catalogMap[key].push({ num: p.num, model: p.model, year: p.year ?? '', codeB, codeF });
  // imgMap é chaveado por num (o código se repete entre motos).
  if (p.image_url) imgMap[p.num] = p.image_url;
}

const brandsOrdered = Object.keys(catalogMap).sort((a, b) =>
  brandLabels[a].localeCompare(brandLabels[b])
);

const catalogJSON = JSON.stringify(catalogMap);
const imgMapJSON  = JSON.stringify(imgMap);
const labelsJSON  = JSON.stringify(brandLabels);
---

<section id="buscador" class="finder" aria-labelledby="finder-title">
  <div class="vz-container finder__inner">

    <!-- Header -->
    <div class="finder__header">
      <p class="vz-overline">Compatibilidade</p>
      <h2 id="finder-title" class="vz-display-m finder__title">
        Encontre a película <span class="finder__title-accent">para sua moto</span>
      </h2>
      <p class="finder__sub">
        Selecione a marca, modelo e ano para ver os produtos compatíveis.
      </p>
    </div>

    <!-- Finder form -->
    <div class="finder__card">
      <form class="finder__form" id="finder-form" novalidate>
        <!-- Step indicators -->
        <div class="finder__steps" aria-hidden="true">
          <div class="finder__step" id="step-1" data-active="true">
            <span class="finder__step-num">1</span>
            <span class="finder__step-label">Marca</span>
          </div>
          <div class="finder__step-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
          <div class="finder__step" id="step-2">
            <span class="finder__step-num">2</span>
            <span class="finder__step-label">Modelo</span>
          </div>
          <div class="finder__step-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
          <div class="finder__step" id="step-3">
            <span class="finder__step-num">3</span>
            <span class="finder__step-label">Ano</span>
          </div>
        </div>

        <!-- Selects row -->
        <div class="finder__selects">
          <!-- Brand -->
          <div class="finder__select-group">
            <label class="finder__label" for="select-brand">Marca</label>
            <select class="vz-select" id="select-brand" name="brand" aria-required="true">
              <option value="">Selecione a marca</option>
              {brandsOrdered.map(key => (
                <option value={key}>{brandLabels[key]}</option>
              ))}
            </select>
          </div>

          <!-- Model -->
          <div class="finder__select-group">
            <label class="finder__label" for="select-model">Modelo</label>
            <select class="vz-select" id="select-model" name="model" disabled aria-required="true">
              <option value="">Selecione o modelo</option>
            </select>
          </div>

          <!-- Year -->
          <div class="finder__select-group">
            <label class="finder__label" for="select-year">Ano</label>
            <select class="vz-select" id="select-year" name="year" disabled aria-required="true">
              <option value="">Selecione o ano</option>
            </select>
          </div>

          <!-- Submit -->
          <div class="finder__select-group finder__select-group--btn">
            <label class="finder__label finder__label--invisible" aria-hidden="true">Buscar</label>
            <button type="submit" class="finder__btn-search" id="btn-search" disabled>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <span>Buscar</span>
            </button>
          </div>
        </div>
      </form>

      <!-- Results area -->
      <div class="finder__results" id="finder-results" aria-live="polite" aria-label="Resultados da busca">
        <!-- Populated by JS -->
      </div>

      <!-- Popular searches -->
      <div class="finder__popular" id="finder-popular">
        <span class="finder__popular-label">Mais buscados:</span>
        <div class="finder__popular-tags">
          <button class="finder__tag" data-brand="honda" data-model="CB 300F Twister" data-year="2023+">Honda CB 300F</button>
          <button class="finder__tag" data-brand="yamaha" data-model="MT-03" data-year="2021–2026">Yamaha MT-03</button>
          <button class="finder__tag" data-brand="kawasaki" data-model="Ninja ZX-10R" data-year="2020–2025">Kawasaki Ninja ZX-10R</button>
          <button class="finder__tag" data-brand="bmw" data-model="R1250 GS / GS Adventure" data-year="2019–2025">BMW R1250 GS</button>
          <button class="finder__tag" data-brand="royal_enfield" data-model="Meteor 350 / Scram 411" data-year="2022–2025">Royal Enfield Meteor</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .finder {
    background-color: var(--vz-off-white);
    padding: var(--section-py) 0;
    position: relative;
  }

  .finder::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--vz-600), var(--vz-400), var(--vz-600));
  }

  .finder__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .finder__header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 560px;
  }

  .finder__title {
    color: var(--vz-700);
    margin: 0;
  }

  .finder__title-accent {
    color: var(--vz-600);
  }

  .finder__sub {
    font-size: 16px;
    color: var(--vz-gray-500);
    margin: 0;
  }

  .finder__card {
    background: #fff;
    border: 1px solid var(--vz-gray-100);
    border-radius: 12px;
    padding: 40px;
    box-shadow: 0 4px 32px rgba(10,46,74,0.06);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .finder__steps {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .finder__step {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.4;
    transition: opacity 0.2s;
  }

  .finder__step[data-active="true"] {
    opacity: 1;
  }

  .finder__step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--vz-gray-100);
    border: 1.5px solid var(--vz-gray-300);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vz-gray-700);
    transition: background 0.2s, border-color 0.2s;
  }

  .finder__step[data-active="true"] .finder__step-num {
    background: var(--vz-600);
    border-color: var(--vz-600);
    color: #fff;
  }

  .finder__step-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--vz-gray-700);
  }

  .finder__step-arrow {
    color: var(--vz-gray-300);
    display: flex;
    align-items: center;
  }

  .finder__selects {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 16px;
    align-items: end;
  }

  .finder__select-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .finder__label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--vz-gray-700);
    letter-spacing: 0.03em;
  }

  .finder__label--invisible {
    opacity: 0;
    pointer-events: none;
    user-select: none;
  }

  .finder__btn-search {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--vz-600);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    padding: 14px 24px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.15s;
    white-space: nowrap;
    height: 52px;
  }

  .finder__btn-search:hover:not(:disabled) {
    background-color: var(--vz-500);
    transform: translateY(-1px);
  }

  .finder__btn-search:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
  }

  .finder__results {
    display: none;
  }

  .finder__results.visible {
    display: block;
  }

  .finder__results-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .finder__result-card {
    display: grid;
    grid-template-columns: minmax(0, 160px) minmax(0, 1fr);
    border: 1px solid var(--vz-gray-100);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .finder__result-card:hover {
    border-color: var(--vz-200);
    box-shadow: 0 4px 20px rgba(10,46,74,0.08);
  }

  .finder__result-img-wrap {
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 16px;
    min-height: 160px;
    border-right: 1px solid var(--vz-gray-100);
    overflow: hidden;
    min-width: 0;
    max-width: 160px;
  }

  .finder__result-img {
    width: 128px;
    height: 128px;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
    min-width: 0;
  }

  .finder__result-body {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
    min-width: 0;
  }

  @media (max-width: 560px) {
    .finder__result-card {
      grid-template-columns: 1fr;
    }
    .finder__result-img-wrap {
      border-right: none;
      border-bottom: 1px solid var(--vz-gray-100);
      min-height: 120px;
    }
  }

  .finder__result-brand {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vz-500);
    margin-bottom: 2px;
  }

  .finder__result-name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 18px;
    color: var(--vz-gray-900);
    line-height: 1.2;
    margin: 0;
  }

  .finder__result-year {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--vz-gray-400);
    margin-top: 2px;
  }

  .finder__result-divider {
    height: 1px;
    background: var(--vz-gray-100);
    margin: 10px 0;
  }

  .finder__result-codes {
    display: flex;
    gap: 24px;
  }

  .finder__result-code-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .finder__result-code-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vz-gray-400);
  }

  .finder__result-code-val {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    color: var(--vz-gray-900);
    letter-spacing: 0.03em;
  }

  .finder__result-code-val--b {
    color: var(--vz-600);
  }

  .finder__wpp-btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 16px;
    padding: 0 20px;
    height: 40px;
    background-color: #128C4A;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 3px;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    transition: background-color 0.25s, box-shadow 0.25s;
    align-self: flex-start;
    box-shadow: 0 1px 0 rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .finder__wpp-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  .finder__wpp-btn::after {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: #25D366;
    border-radius: 3px 0 0 3px;
    transition: width 0.25s;
  }

  .finder__wpp-btn:hover {
    background-color: #0f7a3f;
    box-shadow: 0 3px 12px rgba(18,140,74,0.35), inset 0 1px 0 rgba(255,255,255,0.08);
  }

  .finder__wpp-btn:hover::after {
    width: 5px;
  }

  .finder__wpp-btn svg {
    flex-shrink: 0;
    opacity: 0.95;
  }

  .finder__result-empty {
    text-align: center;
    padding: 32px;
    color: var(--vz-gray-500);
    font-size: 15px;
  }

  .finder__result-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    color: var(--vz-gray-700);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--vz-gray-100);
  }

  .finder__popular {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
    border-top: 1px solid var(--vz-gray-100);
  }

  .finder__popular-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12.5px;
    color: var(--vz-gray-500);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .finder__popular-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .finder__tag {
    background: var(--vz-50);
    border: 1px solid var(--vz-100);
    border-radius: 20px;
    padding: 5px 14px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    color: var(--vz-700);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .finder__tag:hover {
    background: var(--vz-100);
    border-color: var(--vz-300);
    color: var(--vz-600);
  }

  @media (max-width: 900px) {
    .finder__card { padding: 28px 24px; }
    .finder__selects {
      grid-template-columns: 1fr 1fr;
    }
    .finder__select-group--btn {
      grid-column: span 2;
    }
    .finder__select-group--btn .finder__label--invisible { display: none; }
  }

  @media (max-width: 560px) {
    .finder__selects {
      grid-template-columns: 1fr;
    }
    .finder__select-group--btn {
      grid-column: span 1;
    }
    .finder__steps { display: none; }
    .finder__card { padding: 24px 20px; }
  }
</style>

<script define:vars={{ catalogJSON, imgMapJSON, labelsJSON }}>
  const catalog = JSON.parse(catalogJSON);
  const imgMap  = JSON.parse(imgMapJSON);
  const brandLabels = JSON.parse(labelsJSON);

  const brandSelect = document.getElementById('select-brand');
  const modelSelect = document.getElementById('select-model');
  const yearSelect  = document.getElementById('select-year');
  const btnSearch   = document.getElementById('btn-search');
  const resultsEl   = document.getElementById('finder-results');
  const popularEl   = document.getElementById('finder-popular');
  const step1 = document.getElementById('step-1');
  const step2 = document.getElementById('step-2');
  const step3 = document.getElementById('step-3');

  function setStep(n) {
    step1?.setAttribute('data-active', n >= 1 ? 'true' : 'false');
    step2?.setAttribute('data-active', n >= 2 ? 'true' : 'false');
    step3?.setAttribute('data-active', n >= 3 ? 'true' : 'false');
  }

  function hideResults() {
    resultsEl.classList.remove('visible');
    resultsEl.innerHTML = '';
    popularEl.style.display = '';
  }

  brandSelect.addEventListener('change', () => {
    const brand = brandSelect.value;
    modelSelect.innerHTML = '<option value="">Selecione o modelo</option>';
    yearSelect.innerHTML  = '<option value="">Selecione o ano</option>';
    modelSelect.disabled  = true;
    yearSelect.disabled   = true;
    hideResults();
    if (!brand) { setStep(1); btnSearch.disabled = true; return; }
    setStep(2);
    const models = [...new Set((catalog[brand] || []).map(p => p.model))];
    models.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m; opt.textContent = m;
      modelSelect.appendChild(opt);
    });
    modelSelect.disabled = false;
    btnSearch.disabled = false;
  });

  modelSelect.addEventListener('change', () => {
    const brand = brandSelect.value;
    const model = modelSelect.value;
    yearSelect.innerHTML = '<option value="">Selecione o ano</option>';
    yearSelect.disabled  = true;
    hideResults();
    if (!model) { setStep(2); return; }
    setStep(3);
    const years = [...new Set((catalog[brand] || []).filter(p => p.model === model).map(p => p.year))];
    years.forEach(y => {
      const opt = document.createElement('option');
      opt.value = y; opt.textContent = y;
      yearSelect.appendChild(opt);
    });
    yearSelect.disabled = false;
  });

  yearSelect.addEventListener('change', () => {
    // ano é opcional — botão já habilitado desde a marca
  });

  document.getElementById('finder-form')?.addEventListener('submit', e => {
    e.preventDefault();
    runSearch();
  });

  function runSearch() {
    const brand = brandSelect.value;
    const model = modelSelect.value;
    const year  = yearSelect.value;
    if (!brand) return;

    let results = catalog[brand] || [];
    if (model) results = results.filter(p => p.model === model);
    if (year)  results = results.filter(p => p.year === year);
    popularEl.style.display = 'none';
    resultsEl.classList.add('visible');

    if (!results.length) {
      resultsEl.innerHTML = `<div class="finder__result-empty">Nenhum produto encontrado para este modelo. Entre em contato conosco.</div>`;
      return;
    }

    const brandLabel = brandLabels[brand] || brand;
    resultsEl.innerHTML = `
      <div class="finder__result-title"></div>
      <div style="display:flex;flex-direction:column;gap:12px;margin-top:16px;">
        ${results.map(r => {
          const imgSrc = imgMap[r.num] || '';
          const productUrl = `https://vizorpeliculas.com.br/produto/${r.num}`;
          const wppMsg = `Olá! Vi esse produto no site da Vizor Películas e tenho interesse:\n\n*${r.model}* (${r.year})\nCódigo: ${r.codeB}\n\n🔗 ${productUrl}`;
          const wppUrl = `https://wa.me/5551980230392?text=${encodeURIComponent(wppMsg)}`;
          return `
          <div style="display:grid;grid-template-columns:${imgSrc ? 'minmax(0,160px) ' : ''}minmax(0,1fr);border:1px solid #e8edf2;border-radius:10px;overflow:hidden;background:#fff;transition:box-shadow 0.2s,border-color 0.2s;"
               onmouseover="this.style.borderColor='#b3d4f5';this.style.boxShadow='0 4px 20px rgba(10,46,74,0.08)'"
               onmouseout="this.style.borderColor='#e8edf2';this.style.boxShadow='none'">
            ${imgSrc ? `<div style="background:#fff;display:flex;align-items:center;justify-content:center;padding:20px 16px;min-height:160px;border-right:1px solid #e8edf2;overflow:hidden;max-width:160px;"><img src="${imgSrc}" alt="${r.model}" style="width:128px;height:128px;object-fit:contain;display:block;flex-shrink:0;" loading="lazy" decoding="async" /></div>` : ''}
            <div style="padding:20px 24px;display:flex;flex-direction:column;justify-content:center;gap:0;min-width:0;">
              <div style="font-weight:700;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#2a7cc7;margin-bottom:2px;">${brandLabel}</div>
              <div style="font-weight:700;font-size:18px;color:#0d1f2d;line-height:1.2;margin:0 0 2px;">${r.model}</div>
              ${r.year ? `<div style="font-size:13px;color:#9aa5b0;margin-bottom:10px;">${r.year}</div>` : ''}
              <div style="height:1px;background:#e8edf2;margin:8px 0 12px;"></div>
              <div style="display:flex;gap:24px;">
                <div style="display:flex;flex-direction:column;gap:2px;">
                  <span style="font-weight:600;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:#9aa5b0;">Brilho</span>
                  <span style="font-family:monospace;font-weight:600;font-size:15px;color:#2a7cc7;letter-spacing:0.03em;">${r.codeB}</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:2px;">
                  <span style="font-weight:600;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:#9aa5b0;">Fosco</span>
                  <span style="font-family:monospace;font-weight:600;font-size:15px;color:#0d1f2d;letter-spacing:0.03em;">${r.codeF}</span>
                </div>
              </div>
              <a href="${wppUrl}" target="_blank" rel="noopener noreferrer"
                style="display:inline-flex;align-items:center;gap:7px;margin-top:14px;padding:5px 10px;background:#128C4A;color:#fff;font-family:'Barlow',sans-serif;font-weight:700;font-size:11.5px;letter-spacing:0.09em;text-transform:uppercase;border-radius:3px;text-decoration:none;border-left:3px solid #25D366;box-shadow:0 1px 4px rgba(0,0,0,0.15);width:fit-content;"
                onmouseover="this.style.background='#0f7a3f';this.style.boxShadow='0 3px 10px rgba(18,140,74,0.4)'"
