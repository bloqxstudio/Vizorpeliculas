  const brandSelect  = document.getElementById('select-brand') as HTMLSelectElement;
  const modelSelect  = document.getElementById('select-model') as HTMLSelectElement;
  const yearSelect   = document.getElementById('select-year') as HTMLSelectElement;
  const btnSearch    = document.getElementById('btn-search') as HTMLButtonElement;
  const resultsEl    = document.getElementById('finder-results') as HTMLDivElement;
  const popularEl    = document.getElementById('finder-popular') as HTMLDivElement;
  const step1        = document.getElementById('step-1');
  const step2        = document.getElementById('step-2');
  const step3        = document.getElementById('step-3');

  function setStep(n: number) {
    step1?.setAttribute('data-active', n >= 1 ? 'true' : 'false');
    step2?.setAttribute('data-active', n >= 2 ? 'true' : 'false');
    step3?.setAttribute('data-active', n >= 3 ? 'true' : 'false');
  }

  brandSelect.addEventListener('change', () => {
    const brand = brandSelect.value;
    // Reset downstream
    modelSelect.innerHTML = '<option value="">Selecione o modelo</option>';
    yearSelect.innerHTML  = '<option value="">Selecione o ano</option>';
    modelSelect.disabled  = true;
    yearSelect.disabled   = true;
    btnSearch.disabled    = true;
    hideResults();

    if (!brand) { setStep(1); return; }
    setStep(2);

    const products = catalog[brand] || [];
    const models = [...new Set(products.map(p => p.model))];
    models.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      modelSelect.appendChild(opt);
    });
    modelSelect.disabled = false;
  });

  modelSelect.addEventListener('change', () => {
    const brand = brandSelect.value;
    const model = modelSelect.value;
    yearSelect.innerHTML = '<option value="">Selecione o ano</option>';
    yearSelect.disabled  = true;
    btnSearch.disabled   = true;
    hideResults();

    if (!model) { setStep(2); return; }
    setStep(3);

    const products = (catalog[brand] || []).filter(p => p.model === model);
    const years = [...new Set(products.map(p => p.year))];
    years.forEach(y => {
      const opt = document.createElement('option');
      opt.value = y;
      opt.textContent = y;
      yearSelect.appendChild(opt);
    });
    yearSelect.disabled = false;
  });

  yearSelect.addEventListener('change', () => {
    btnSearch.disabled = !yearSelect.value;
  });

  document.getElementById('finder-form')?.addEventListener('submit', e => {
    e.preventDefault();
    runSearch();
  });

  function runSearch() {
    const brand = brandSelect.value;
    const model = modelSelect.value;
    const year  = yearSelect.value;

    if (!brand || !model || !year) return;

    const results = (catalog[brand] || []).filter(
      p => p.model === model && p.year === year
    );

    popularEl.style.display = 'none';
    resultsEl.classList.add('visible');

    if (results.length === 0) {
      resultsEl.innerHTML = `
        <div class="finder__result-empty">
          Nenhum produto encontrado para este modelo. Entre em contato conosco.
        </div>`;
      return;
    }

    resultsEl.innerHTML = `
      <div class="finder__result-title"></div>
      <div class="finder__results-grid">
        ${results.map(r => {
          const imgSrc = imgMap[r.codeB] || '';
          const imgHtml = imgSrc
            ? `<div class="finder__result-img-wrap"><img src="${imgSrc}" alt="${r.model}" class="finder__result-img" loading="lazy" decoding="async" /></div>`
            : '';
          const productUrl = `https://vizorpeliculas.com.br/produto/${r.codeB}`;
          const wppMsg = `Olá! Vi esse produto no site da Vizor Películas e tenho interesse:\n\n*${r.model}* (${r.year})\nCódigo: ${r.codeB}\n\n🔗 ${productUrl}`;
          const wppUrl = `https://wa.me/5551980230392?text=${encodeURIComponent(wppMsg)}`;
          return `
          <div class="finder__result-card" style="display:grid;grid-template-columns:minmax(0,160px) minmax(0,1fr);border:1px solid #e8edf2;border-radius:10px;overflow:hidden;background:#fff;">
            ${imgSrc ? `<div style="background:#f0f4f8;display:flex;align-items:center;justify-content:center;padding:20px 16px;min-height:160px;border-right:1px solid #e8edf2;overflow:hidden;"><img src="${imgSrc}" alt="${r.model}" style="width:128px;height:128px;object-fit:contain;display:block;" loading="lazy" decoding="async" /></div>` : ''}
            <div style="padding:20px 24px;display:flex;flex-direction:column;justify-content:center;gap:0;min-width:0;">
              <div style="font-weight:700;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#2a7cc7;margin-bottom:4px;">${brandSelect.options[brandSelect.selectedIndex].text}</div>
              <div style="font-weight:700;font-size:18px;color:#0d1f2d;line-height:1.2;margin:0 0 2px;">${r.model}</div>
              ${r.year ? `<div style="font-size:13px;color:#9aa5b0;margin-bottom:10px;">${r.year}</div>` : ''}
              <div style="height:1px;background:#e8edf2;margin:8px 0 12px;"></div>
              <div style="display:flex;gap:24px;">
                <div style="display:flex;flex-direction:column;gap:2px;">
                  <span style="font-weight:600;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:#9aa5b0;">Brilho</span>
                  <span style="font-family:monospace;font-weight:600;font-size:15px;color:#2a7cc7;letter-spacing:0.03em;">${r.codeB}</span>
                </div>
                <div style="display:flex;flex-direction:column;gap:2px;">
                  <span style="font-weight:600;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:#9aa5b0;">Fosco</span>
                  <span style="font-family:monospace;font-weight:600;font-size:15px;color:#0d1f2d;letter-spacing:0.03em;">${r.codeF}</span>
                </div>
              </div>
              <a href="${wppUrl}" target="_blank" rel="noopener noreferrer"
                style="display:inline-flex;align-items:center;gap:7px;margin-top:14px;padding:5px 10px;background:#128C4A;color:#fff;font-family:'Barlow',sans-serif;font-weight:700;font-size:11.5px;letter-spacing:0.09em;text-transform:uppercase;border-radius:3px;text-decoration:none;border-left:3px solid #25D366;box-shadow:0 1px 4px rgba(0,0,0,0.15);width:fit-content;"
                onmouseover="this.style.background='#0f7a3f';this.style.boxShadow='0 3px 10px rgba(18,140,74,0.4)'"
                onmouseout="this.style.background='#128C4A';this.style.boxShadow='0 1px 4px rgba(0,0,0,0.15)'"
                aria-label="Falar no WhatsApp sobre ${r.model}">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="opacity:.9;flex-shrink:0;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Tenho interesse
              </a>
            </div>
          </div>`;
        }).join('')}
      </div>`;
  }

  function hideResults() {
    resultsEl.classList.remove('visible');
    resultsEl.innerHTML = '';
    popularEl.style.display = '';
  }

  // Quick-search tags
  document.querySelectorAll('.finder__tag').forEach(tag => {
    tag.addEventListener('click', () => {
      const btn = tag as HTMLElement;
      const brand = btn.dataset.brand || '';
      const model = btn.dataset.model || '';
      const year  = btn.dataset.year  || '';

      brandSelect.value = brand;
      brandSelect.dispatchEvent(new Event('change'));

      setTimeout(() => {
        // Find closest model match
        const opts = Array.from(modelSelect.options);
        const match = opts.find(o => o.value === model || o.value.includes(model.split(' ')[0]));
        if (match) { modelSelect.value = match.value; modelSelect.dispatchEvent(new Event('change')); }

        setTimeout(() => {
          const yearOpts = Array.from(yearSelect.options);
          const yMatch = yearOpts.find(o => o.value.includes(year));
          if (yMatch) { yearSelect.value = yMatch.value; btnSearch.disabled = false; }
        }, 50);
      }, 50);
    });
  });
</script>
